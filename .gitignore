# ==========================================
# 1. AIR QUALITY & GEO-SPATIAL DATASETS
# ==========================================
# Exclude raw sensor dumps, heavy GeoJSON, and local spatial caches
data/
*.csv
*.xlsx
*.parquet
*.feather
*.json
*.geojson
*.shp
*.dbf
*.shx
*.prj

# Preserve folder structure on GitHub while keeping data ignored
!data/.gitkeep

# ==========================================
# 2. LOCAL ENVIRONMENT & API KEYS
# ==========================================
# Protect OpenAQ, AirQo, Sensor.Community, or IQAir API keys
.env
.env.local
.envrc
secrets.toml
.streamlit/secrets.toml

# ==========================================
# 3. PYTHON & EXECUTION CACHES
# ==========================================
__pycache__/
*.py[codz]
*$py.class
*.so

# Environments
.venv/
venv/
ENV/
env/

# ==========================================
# 4. JUPYTER & EXPLORATORY NOTEBOOKS
# ==========================================
# Exclude notebook checkpoints and temporary scraping dumps
.ipynb_checkpoints
*.ipynb_checkpoints/
profile_default/
ipython_config.py

# ==========================================
# 5. STREAMLIT & IDE SYSTEM FILES
# ==========================================
.vscode/
.idea/
.DS_Store
*.tmp

# ==========================================
# 6. TESTING, COVERAGE & RUFF
# ==========================================
.pytest_cache/
.ruff_cache/
.mypy_cache/
